# =============================================================================
# Polaris — environment template (safe to commit)
# Copy to .env and fill secrets marked CHANGE_ME
#   cp .env.example .env
# =============================================================================

# --- Project -----------------------------------------------------------------
POLARIS_PROJECT_NAME=Polaris
POLARIS_SIH_PS=26060
POLARIS_PROJECT_ROOT=c:/projects/polaris
POLARIS_DATA_DIR=c:/projects/polaris/datasets
POLARIS_WSL_DISTRO=Ubuntu

# --- PostgreSQL (WSL user-space, no Docker) --------------------------------
POLARIS_PGHOST=127.0.0.1
POLARIS_PGPORT=5432
POLARIS_PGUSER=polaris
POLARIS_PGPASSWORD=polaris
POLARIS_PGDATABASE=polaris
DATABASE_URL=postgresql://polaris:polaris@127.0.0.1:5432/polaris

POLARIS_PG_PREFIX=/home/YOUR_USER/.local/share/polaris-pg
POLARIS_PGDATA=/home/YOUR_USER/.local/share/polaris-pgdata
POLARIS_TS_SRC=/home/YOUR_USER/.local/src/timescaledb

# --- pgvector / knowledge RAG ------------------------------------------------
POLARIS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
POLARIS_EMBED_DIM=384
POLARIS_USE_LOCAL_EMBEDDINGS=false

# --- Twin engine defaults ----------------------------------------------------
POLARIS_DEFAULT_SCENARIO=BASELINE
POLARIS_DEFAULT_CLOCK=2023-08-05T18:00:00Z
POLARIS_REPLAY_SCENARIO=REPLAY_2018_08_05
POLARIS_TIMEZONE=UTC

# --- Station identity --------------------------------------------------------
POLARIS_MAITRI_LAT=-70.76683367
POLARIS_MAITRI_LON=11.73078318
POLARIS_BHARATI_LAT=-69.40680
POLARIS_BHARATI_LON=76.19525
POLARIS_NOVO_ICAO=AT17

# --- External data APIs ------------------------------------------------------
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
NPDC_PORTAL_URL=https://npdc.ncpor.res.in
NPDC_RAMADDA_URL=https://ramadda.npdc.ncpor.res.in
NPDC_USERNAME=
NPDC_PASSWORD=
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
NASA_POWER_URL=https://power.larc.nasa.gov/api
NOAA_SWPC_BASE=https://services.swpc.noaa.gov/json

# --- Future app / API layer --------------------------------------------------
POLARIS_API_HOST=127.0.0.1
POLARIS_API_PORT=8000
POLARIS_API_SECRET_KEY=CHANGE_ME_generate_a_long_random_string
POLARIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CESIUM_ION_ACCESS_TOKEN=

# --- Logging -----------------------------------------------------------------
POLARIS_LOG_LEVEL=INFO
POLARIS_DEBUG=false
